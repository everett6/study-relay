# Study Relay settings. Copy to .env (chmod 600) and fill in what you use; everything is optional.
# ./setup-integrations.sh fills in the Discord and email parts for you.

# --- relay
# RELAY_ADDR=127.0.0.1:8000       # default: this machine only. Use :8000 to reach it from other devices.
# RELAY_TOKEN=                    # shared secret. If empty and RELAY_ADDR is not loopback, one is generated
                                  # next to the database; `study-relay pair` prints a sign-in link.
# RELAY_DB=study-relay.db
# TZ_NAME=America/Los_Angeles
# RELAY_ALLOWED_ORIGINS=          # extra web origins allowed to call the API (comma list)

# --- Canvas (read-only: classes, grades, assignments, announcements)
CANVAS_BASE_URL=https://esuhsd.instructure.com
CANVAS_API_TOKEN=

# --- Discord (read club channels; post your plan only when you press Share)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=
DISCORD_WEBHOOK_URL=

# --- Email (use an app password, never your real password)
IMAP_ADDR=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FILTERS=esuhsd.org,counselor,college,club,robotics,scholarship
COUNSELOR_KEYWORDS=counselor,college,naviance,scholarship
SMTP_ADDR=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# POLL_MINUTES=10

# --- optional native model next to the relay (Ollama / llama-server, OpenAI-compatible)
# LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=
# LOCAL_LLM_CTX=32768
# Cloud model via OpenRouter (gpt-6-luna): Settings -> Connections -> preset "OpenRouter", or:
# LOCAL_LLM_URL=https://openrouter.ai/api/v1
# LOCAL_LLM_MODEL=openai/gpt-6-luna
# LOCAL_LLM_API_KEY=   (or OPENROUTER_API_KEY=)
