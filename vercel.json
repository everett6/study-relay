{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "true",
  "buildCommand": "cd web && npm ci --no-audit --no-fund && npm run build",
  "outputDirectory": "server/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://studyflow.tail1bc539.ts.net/api/:path*" },
    { "source": "/mcp", "destination": "https://studyflow.tail1bc539.ts.net/mcp" },
    { "source": "/mcp/:path*", "destination": "https://studyflow.tail1bc539.ts.net/mcp/:path*" },
    { "source": "/healthz", "destination": "https://studyflow.tail1bc539.ts.net/healthz" },
    { "source": "/.well-known/:path*", "destination": "https://studyflow.tail1bc539.ts.net/.well-known/:path*" },
    { "source": "/oauth/:path*", "destination": "https://studyflow.tail1bc539.ts.net/oauth/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
